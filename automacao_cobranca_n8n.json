        "query": "SELECT\n    c.nome,\n    c.email,\n    p.status_pagamento,\n    e.valor_emprestimo,\n    p.id_parcela\nFROM parcelas p\nJOIN emprestimo e\n    ON p.id_emprestimo = e.id_emprestimo\nJOIN clientes c\n    ON e.id_cliente = c.id_cliente\nWHERE p.status_pagamento = 0;",
